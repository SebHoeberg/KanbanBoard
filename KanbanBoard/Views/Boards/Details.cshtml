
@using KanbanBoard.Models
@model Board

@{
ViewData["Title"] = Model.Name;

// Uppgifterna sorteras i BoardsController med vald Strategy.
var tasks = ViewBag.Tasks as List<KanbanTask> ?? new List<KanbanTask>();
var selectedSort = ViewBag.SelectedSort as string ?? "priority";

// Tavlans fyra fasta kolumner.
var columns = new[]
{
new { Status = KanbanBoard.Models.TaskStatus.Backlog, Name = "Backlogg" },
new { Status = KanbanBoard.Models.TaskStatus.Todo, Name = "Att göra" },
new { Status = KanbanBoard.Models.TaskStatus.InProgress, Name = "Pågår" },
new { Status = KanbanBoard.Models.TaskStatus.Done, Name = "Klart" }
};
}

<div class="kanban-container">

    <div class="mb-4">
        <a asp-controller="Boards"
           asp-action="Index"
           class="text-decoration-none text-secondary">
            ← Tillbaka till mina tavlor
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">@Model.Name</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
            <p class="page-description">@Model.Description</p>
            }
        </div>

        <div class="d-flex gap-2">
            @* Ny knapp för att redigera tavlans namn och beskrivning. *@
            <a asp-controller="Boards"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-kanban-secondary">
                Redigera tavla
            </a>

            @* POST används för att radera tavlan och dess uppgifter.
               Bekräftelsen visas innan formuläret skickas. *@
            <form asp-controller="Boards"
                  asp-action="Delete"
                  method="post"
                  onsubmit="return confirm('Vill du verkligen ta bort tavlan och ALLA dess uppgifter? Detta går inte att ångra.');">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-kanban-secondary text-danger">
                    Ta bort tavla
                </button>
            </form>

            <a asp-controller="KanbanTasks"
               asp-action="Create"
               asp-route-boardId="@Model.Id"
               class="btn btn-kanban-primary">
                + Ny uppgift
            </a>
        </div>
    </div>

    @* Sortering med Strategy pattern. *@
    <div class="d-flex justify-content-end align-items-center gap-3 mb-4">
        <label for="sort" class="text-secondary mb-0">
            Sortera efter:
        </label>

        <form asp-controller="Boards"
              asp-action="Details"
              asp-route-id="@Model.Id"
              method="get">

            <select id="sort"
                    name="sort"
                    class="form-select bg-dark text-light border-secondary"
                    onchange="this.form.submit()">

                <option value="priority"
                        selected="@(selectedSort == "priority")">
                    Prioritet
                </option>

                <option value="deadline"
                        selected="@(selectedSort == "deadline")">
                    Deadline
                </option>

                <option value="title"
                        selected="@(selectedSort == "title")">
                    Titel (A–Ö)
                </option>

            </select>
        </form>
    </div>

    @* Tavlans fyra kolumner. *@
    <div class="row g-3">

        @foreach (var column in columns)
        {
        var columnTasks = tasks
        .Where(task => task.Status == column.Status)
        .ToList();

        <div class="col-12 col-md-6 col-xl-3">
            <div class="kanban-card h-100 kanban-dropzone"
                 data-status="@((int)column.Status)">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="kanban-card-title mb-0">
                        @column.Name
                    </h3>

                    <span class="badge bg-secondary">
                            @columnTasks.Count
                        </span>
                </div>

                @if (!columnTasks.Any())
                {
                <p class="kanban-card-description">
                    Inga uppgifter ännu.
                </p>
                }
                else
                {
                @foreach (var task in columnTasks)
                {
                <div class="kanban-card mb-3 kanban-draggable"
                     draggable="true"
                     data-task-id="@task.Id"
                     data-current-status="@((int)task.Status)"
                     style="cursor: grab;">

                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h5 class="kanban-card-title">
                            @task.Title
                        </h5>

                        <a asp-controller="KanbanTasks"
                           asp-action="Edit"
                           asp-route-id="@task.Id"
                           class="btn btn-kanban-secondary btn-sm">
                            Redigera
                        </a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                    <p class="kanban-card-description">
                        @task.Description
                    </p>
                    }

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-secondary">
                            Prioritet: @task.Priority
                        </small>

                        @if (task.DueDate.HasValue)
                        {
                        <small class="text-secondary">
                            @task.DueDate.Value.ToString("yyyy-MM-dd")
                        </small>
                        }
                    </div>

                    @* Vanliga flyttknappar behålls. *@
                    <div class="d-flex justify-content-between gap-2 mt-3">

                        @if (task.Status != KanbanBoard.Models.TaskStatus.Backlog)
                        {
                        <form asp-controller="KanbanTasks"
                              asp-action="Move"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@task.Id" />

                            <input type="hidden"
                                   name="status"
                                   value="@((int)task.Status - 1)" />

                            <button type="submit"
                                    class="btn btn-kanban-secondary btn-sm">
                                ← Flytta
                            </button>
                        </form>
                        }
                        else
                        {
                        <span></span>
                        }

                        @if (task.Status != KanbanBoard.Models.TaskStatus.Done)
                        {
                        <form asp-controller="KanbanTasks"
                              asp-action="Move"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@task.Id" />

                            <input type="hidden"
                                   name="status"
                                   value="@((int)task.Status + 1)" />

                            <button type="submit"
                                    class="btn btn-kanban-secondary btn-sm">
                                Flytta →
                            </button>
                        </form>
                        }

                    </div>

                    @* Borttagning av uppgift. *@
                    <form asp-controller="KanbanTasks"
                          asp-action="Delete"
                          method="post"
                          class="mt-3"
                          onsubmit="return confirm('Vill du verkligen ta bort den här uppgiften?');">

                        <input type="hidden"
                               name="id"
                               value="@task.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            Ta bort
                        </button>
                    </form>

                </div>
                }
                }

            </div>
        </div>
        }

    </div>
</div>

@* Dolt formulär för drag-and-drop. *@
<form id="dragDropMoveForm"
      asp-controller="KanbanTasks"
      asp-action="Move"
      method="post"
      class="d-none">

    <input type="hidden"
           name="id"
           id="dragTaskId" />

    <input type="hidden"
           name="status"
           id="dragTaskStatus" />
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const draggableCards = document.querySelectorAll(".kanban-draggable");
        const dropzones = document.querySelectorAll(".kanban-dropzone");

        const moveForm = document.getElementById("dragDropMoveForm");
        const taskIdInput = document.getElementById("dragTaskId");
        const statusInput = document.getElementById("dragTaskStatus");

        let draggedCard = null;
        let submitting = false;

        draggableCards.forEach(card => {

            card.addEventListener("dragstart", function (event) {
                if (submitting) {
                    event.preventDefault();
                    return;
                }

                draggedCard = card;

                event.dataTransfer.effectAllowed = "move";
                event.dataTransfer.setData("text/plain", card.dataset.taskId);

                card.style.opacity = "0.5";
            });

            card.addEventListener("dragend", function () {
                card.style.opacity = "1";
                draggedCard = null;

                dropzones.forEach(zone => {
                    zone.style.outline = "";
                });
            });
        });

        dropzones.forEach(zone => {

            zone.addEventListener("dragover", function (event) {
                if (!draggedCard || submitting) {
                    return;
                }

                event.preventDefault();
                event.dataTransfer.dropEffect = "move";

                zone.style.outline = "2px dashed #6ea8fe";
            });

            zone.addEventListener("dragleave", function (event) {
                if (!zone.contains(event.relatedTarget)) {
                    zone.style.outline = "";
                }
            });

            zone.addEventListener("drop", function (event) {
                event.preventDefault();
                zone.style.outline = "";

                if (!draggedCard || submitting) {
                    return;
                }

                const taskId = draggedCard.dataset.taskId;
                const newStatus = zone.dataset.status;
                const oldStatus = draggedCard.dataset.currentStatus;

                if (newStatus === oldStatus) {
                    return;
                }

                // Skickar uppgiftens ID och nya status till MVC-controllern.
                taskIdInput.value = taskId;
                statusInput.value = newStatus;

                submitting = true;
                moveForm.requestSubmit();
            });
        });
    });
</script>
}
