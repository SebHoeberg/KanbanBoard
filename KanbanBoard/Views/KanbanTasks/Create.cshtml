
@using KanbanBoard.Models
@model KanbanTask

@{
    ViewData["Title"] = "Ny uppgift";
}

<div class="kanban-container">

    <div class="mb-4">
        <h1 class="page-title">Skapa ny uppgift</h1>
        <p class="page-description">
            Lägg till en uppgift på din Kanban-tavla.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-7 col-xl-6">
            <div class="kanban-card">

                @* Formuläret skickas till POST-metoden i KanbanTasksController. *@
                <form asp-controller="KanbanTasks"
                      asp-action="Create"
                      method="post">

                    @* Kopplar uppgiften till tavlan som användaren öppnade. *@
                    <input asp-for="BoardId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">
                            Titel
                        </label>

                        <input asp-for="Title"
                               class="form-control kanban-input"
                               placeholder="Exempel: Färdigställ projektrapporten"
                               maxlength="150" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            Beskrivning (valfritt)
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control kanban-input"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Beskriv vad som behöver göras..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Priority" class="form-label">
                            Prioritet
                        </label>

                        <select asp-for="Priority"
                                class="form-select kanban-input">
                            <option value="0">Låg</option>
                            <option value="1">Normal</option>
                            <option value="2">Hög</option>
                        </select>

                        <span asp-validation-for="Priority"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DueDate" class="form-label">
                            Deadline (valfritt)
                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control kanban-input" />

                        <span asp-validation-for="DueDate"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-kanban-primary">
                            Skapa uppgift
                        </button>

                        <a asp-controller="Boards"
                           asp-action="Details"
                           asp-route-id="@Model.BoardId"
                           class="btn btn-kanban-secondary">
                            Avbryt
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
